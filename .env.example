# Postgres (Neon) — must have the pgvector extension enabled
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/callwise?sslmode=require

# OpenAI — used for chat completions + embeddings
OPENAI_API_KEY=sk-...

# Auth.js
AUTH_SECRET=generate-with-npx-auth-secret

# Twilio (optional): setting the auth token switches the phone line on
TWILIO_AUTH_TOKEN=
